$C = "../Common.ui";


Group #PocketPortalContent {
    LayoutMode: MiddleCenter;
    Anchor: (Top: 700);
    FlexWeight: 1;
    Group {
        LayoutMode: Left;
        Label #PortalTooltip {
          Padding: (Full: 10);
          Style: (FontSize: 20, TextColor: #ffffff);
          Text: "[M1]: Teleport / [M2]: Save Location";
        }
    }
  }