$C = "../Common.ui";

$C.@PageOverlay {
  $C.@Container {
    Anchor: (Width: 520, Height: 520);

    #Title {
      Group {
        $C.@Title {
          @Text = "Teleport Locations";
        }
      }
    }

    #Content {
      LayoutMode: Left;

      Group #Main {
        LayoutMode: Top;
        FlexWeight: 1;

        Group #StatsBar {
          LayoutMode: Left;
          Anchor: (Bottom: 12);

          Label {
            Style: (
              FontSize: 16,
              TextColor: #c29cf3,
              RenderBold: true
            );
            Text: "Saved Locations";
          }

          Label {
            FlexWeight: 1;
          }

          Label {
            Style: (
              FontSize: 13,
              TextColor: #c29cf3(0.6)
            );
            Text: "Total: ";
          }

          Label #TeleportCount {
            Style: (
              FontSize: 13,
              TextColor: #c300ff,
              RenderBold: true
            );
            Text: "0";
          }
        }

        Group #IndexList {
          Anchor: (Top: 2);
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;

          Group #IndexCards {
            LayoutMode: Top;
          }
        }

        Group #NoTeleportsMessage {
          Visible: false;
          Anchor: (Top: 40);

          Label {
            Style: (
              FontSize: 15,
              TextColor: #c29cf3(0.5),
              HorizontalAlignment: Center
            );
            Text: "No saved locations yet.";
          }

          Label {
            Anchor: (Top: 8);
            Style: (
              FontSize: 13,
              TextColor: #c29cf3(0.35),
              HorizontalAlignment: Center
            );
            Text: "Hold the portal and use the secondary interaction to save one.";
          }
        }
      }
    }
  }
}

$C.@BackButton {}