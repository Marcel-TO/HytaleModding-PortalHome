$C = "../Common.ui";

$C.@PageOverlay {
  $C.@Container {
    Anchor: (Width: 460, Height: 300);

    #Title {
      Group {
        $C.@Title {
          @Text = "Save Teleport Location";
        }
      }
    }

    #Content {
      LayoutMode: Left;

      Group #Main {
        LayoutMode: Top;
        FlexWeight: 1;

        Group #StatsBar {
          LayoutMode: Left;
          Anchor: (Bottom: 20);

          Label {
            Style: (
              FontSize: 16,
              TextColor: #c29cf3,
              RenderBold: true
            );
            Text: "Current Position:";
          }

          Label {
            FlexWeight: 1;
          }

          Label #CurrentPosition {
            Style: (
              FontSize: 14,
              TextColor: #c300ff,
              RenderBold: true
            );
            Text: "0";
          }
        }

        Label {
          Anchor: (Bottom: 6);
          Style: (
            FontSize: 14,
            TextColor: #c29cf3
          );
          Text: "Location Name:";
        }

        $C.@TextField #NameInput {
          Anchor: (Bottom: 12, Height: 36);
        }

        $C.@TextButton #SaveButton {
          Anchor: (Height: 36, Bottom: 10);
          Text: "SAVE";
        }

        Label {
          Style: (
            FontSize: 11,
            TextColor: #f0b040,
            HorizontalAlignment: Center
          );
          Text: "Warning: Saving with an existing name will overwrite that location.";
        }
      }
    }
  }
}
$C.@BackButton {}
